# ============================================================================
# Development Environment Configuration
# ============================================================================
# USAGE:
#   1. Copy this file to .env:
#      cp dev.env .env
#
#   2. Update the values below as needed for your local development
#
#   3. IMPORTANT: Never commit .env to git (it's already in .gitignore)
# ============================================================================

PYTHONENCODING=utf8
DEBUG=1
CONFIGURATION=dev
DJANGO_LOG_LEVEL=INFO

# [REQUIRED] Django secret key - generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# For development, this default key is fine. For production, generate a new secure one!
SECRET_KEY=dev-secret-key-ebbwigc1vQnrfxgDVHQe1AxvqB5GxHNWWPG-7GdFqDJHqKljk80AvDmmToEiD_wcmMQ

# [REQUIRED] Comma-separated list of allowed hostnames
ALLOWED_HOSTS=example.com

# [REQUIRED] Database configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpassword

# [REQUIRED] Redis configuration
REDIS_URL=redis://redis:6379/0

# [REQUIRED] Site configuration
SITE_DOMAIN=example.com
SITE_URL=http://NEWPROJECTNAME.local:8000

# [OPTIONAL] Email configuration - required only if sending emails
EMAIL_HOST=""
EMAIL_PORT=25
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""

# [OPTIONAL] Sentry DSN for error tracking - leave empty to disable
# Get your DSN from: https://sentry.io/settings/projects/<your-project>/keys/
SENTRY_DSN=""

# [REQUIRED] Celery Flower monitoring credentials
CELERY_FLOWER_USER=flower
CELERY_FLOWER_PASSWORD=""

# [REQUIRED] Caddy server password hash - generate with: caddy hash-password
CADDY_PASSWORD=""

# [OPTIONAL] Vite dev server host - only needed for development
VITE_DEV_SERVER_HOST=localhost

# [REQUIRED] Docker Compose project name - used for image naming
COMPOSE_PROJECT_NAME=django_app

DJANGO_SETTINGS_MODULE=config.settings.dev
