# ============================================================================
# Production Environment Configuration
# ============================================================================
# USAGE:
#   1. Copy this file to .env:
#      cp prod.env .env
#
#   2. CRITICAL: Update ALL values marked as [REQUIRED] below
#      - Generate a secure SECRET_KEY
#      - Set your actual domain in ALLOWED_HOSTS
#      - Set secure database credentials
#
#   3. Deploy validation will check for placeholder values and fail if found
#
#   4. IMPORTANT: Never commit .env to git (it's already in .gitignore)
# ============================================================================

PYTHONENCODING=utf8
DEBUG=0
CONFIGURATION=prod
DJANGO_LOG_LEVEL=INFO

# [REQUIRED] Django secret key
# CRITICAL: Generate a NEW secure key for production!
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=""

# [REQUIRED] Comma-separated list of allowed hostnames
# CRITICAL: Replace example.com with your actual domain!
ALLOWED_HOSTS=example.com

# [REQUIRED] Database configuration
# CRITICAL: Set a secure password for production!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=""

# [REQUIRED] Redis configuration
REDIS_URL=redis://redis:6379/0

# [REQUIRED] Site configuration
SITE_DOMAIN=example.com
SITE_URL=https://example.com

# [OPTIONAL] Email configuration - required only if sending emails
EMAIL_HOST=""
EMAIL_PORT=25
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""

# [OPTIONAL] Sentry DSN for error tracking - leave empty to disable
# Get your DSN from: https://sentry.io/settings/projects/<your-project>/keys/
SENTRY_DSN=""

# [REQUIRED] Celery Flower monitoring credentials
CELERY_FLOWER_USER=flower
CELERY_FLOWER_PASSWORD=""

# [REQUIRED] Caddy server password hash - generate with: caddy hash-password
CADDY_PASSWORD=""

# [OPTIONAL] Vite dev server host - only needed for development
VITE_DEV_SERVER_HOST=""

DJANGO_SETTINGS_MODULE=config.settings.prod